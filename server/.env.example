# xiaozhi-esp32-server 环境变量模板
# 实际部署时复制为 .env 并填入真实的 API 密钥
# .env 已加入 .gitignore，不会入库

# LLM 主力：MiMo mimo-v2.5-pro（token-plan 端点，OpenAI 兼容）
MIMO_API_KEY=your_mimo_api_key_here

# LLM 备选：DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ASR：Qwen3-ASR-Flash（阿里云百炼 DashScope）
DASHSCOPE_API_KEY=your_dashscope_api_key_here
